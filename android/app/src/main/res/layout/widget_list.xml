<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl">
    <ImageView android:id="@+id/bgimg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wbg_shape"/>
    <ImageView android:id="@+id/ring" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wring_shape"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/n1" android:text="الفجر" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/t1" android:text="4:59 ص" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/n2" android:text="الظهر" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/t2" android:text="12:09 م" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/n3" android:text="العصر" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/t3" android:text="3:15 م" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/n4" android:text="المغرب" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/t4" android:text="6:01 م" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/n5" android:text="العشاء" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/t5" android:text="7:31 م" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp"/>
        </LinearLayout>
        <Chronometer android:id="@+id/cd" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="20sp" android:textStyle="bold"/>
</LinearLayout></FrameLayout>
